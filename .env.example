# Copy this file to .env and fill in your values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local PostgreSQL ---
DB_NAME=timbang
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# --- Supabase (alternative) ---
# Project Settings > Database > Connection string. Use the same variables:
# DB_NAME=postgres
# DB_USER=postgres            (or postgres.<project-ref> when using the pooler)
# DB_PASSWORD=your-supabase-db-password
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_SSLMODE=require
